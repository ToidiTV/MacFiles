			<string>%ld элемент</string>
			<key>other</key>
			<string>%ld элемента</string>
		</dict>
	</dict>
	<key>NativeSelectedCount</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
